# Backend environment variables
# Copy this file to backend/.env and replace the placeholder with your own key.
# NEVER commit backend/.env or share its contents.

# Required: create a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace_with_your_new_google_ai_studio_key

# Optional: the backend defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated frontend origins. Keep local origins for development.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
